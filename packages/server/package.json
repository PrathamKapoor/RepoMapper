{
  "name": "@repoatlas/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RepoAtlas analysis orchestration, persistence and HTTP API.",
  "license": "MIT",
  "author": "PrathamKapoor <prathamkapoor027@gmail.com>",
  "main": "./dist/main.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@fastify/static": "8.3.0",
    "@repoatlas/artifacts": "0.1.0",
    "@repoatlas/core": "0.1.0",
    "@repoatlas/ingest": "0.1.0",
    "@repoatlas/parsers": "0.1.0",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "start": "node dist/main.js"
  }
}
