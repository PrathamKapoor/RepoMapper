# RepoAtlas configuration
#
# Copy to `.env` for local use. Every value below is the documented default, so an
# empty environment behaves exactly like this file.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=4300

# ------------------------------------------------------------------ security
# Semicolon- or comma-separated absolute paths. The API refuses to analyse anything
# outside these roots. LEAVING THIS EMPTY MEANS NO ALLOW-LIST IS ENFORCED, and
# /api/health will report pathAllowListEnforced=false.
#
# In Docker, /repos is the conventional mount point.
# REPOATLAS_ALLOWED_ROOTS=/repos

# Path to the SQLite database file. Use ':memory:' for a throwaway instance.
REPOATLAS_DB_PATH=var/repoatlas.sqlite

# Hard cap on request body size, which also bounds archive uploads.
REPOATLAS_MAX_UPLOAD_BYTES=268435456

# Maximum number of analyses retained in the database. Reaching it is a 507.
REPOATLAS_MAX_ANALYSES=50

# How many analyses may run at once. Further requests get a 429.
REPOATLAS_CONCURRENCY=2

# Optional CORS origin. Unset means CORS is disabled entirely.
# REPOATLAS_CORS_ORIGIN=https://atlas.example.com

# ------------------------------------------------------------------ analysis
# Read git history for commits, contributors and ownership. Set false for archives.
REPOATLAS_INCLUDE_GIT=true

# Directory holding the built web UI. Auto-detected in production; set explicitly
# when running outside the standard layout.
# REPOATLAS_STATIC_DIR=packages/web/dist

# Abandon an analysis that exceeds this many milliseconds.
REPOATLAS_ANALYSIS_TIMEOUT_MS=300000

# -------------------------------------------------------------------- logging
# fatal | error | warn | info | debug | trace | silent
REPOATLAS_LOG_LEVEL=info

# --------------------------------------------------------------- dev proxy
# Target the Vite dev server proxies /api to.
# REPOATLAS_API_URL=http://127.0.0.1:4300